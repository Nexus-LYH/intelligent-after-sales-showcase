{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": {
      "vue": [
        "./node_modules/vue"
      ],
      "vue-router": [
        "./node_modules/vue-router"
      ],
      "pinia": [
        "./node_modules/pinia"
      ],
      "element-plus": [
        "./node_modules/element-plus"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "tests/**/*.ts"
  ]
}
